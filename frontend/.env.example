# PhronesisML frontend environment configuration.
# Copy to `.env.local` and adjust. Never commit real secrets.

# Base URL of the PhronesisML HTTP API (FastAPI backend, all routes under /api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket base URL used for live run events.
VITE_WS_BASE_URL=ws://localhost:8000/api/v1

# Force demo mode on/off. "true" uses the in-browser mock data layer.
# Allowed: true | false. Leave unset (or "false") for real backend mode.
VITE_DEMO_MODE=false

# Auth mode. Leave as "disabled" for the no-auth prototype (single-tenant
# local identity, no login gate). Set to "supabase" ONLY when the backend also
# runs AUTH_MODE=supabase and the two Supabase values below are set.
VITE_AUTH_MODE=disabled

# Supabase auth (opt-in). Ignored unless VITE_AUTH_MODE=supabase. Copy from the
# Supabase Dashboard -> Settings -> API. Placeholders only; never real secrets.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=