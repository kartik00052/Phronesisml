# PhronesisML container deployment — optional overrides.
# Copy this file to `.env` in the repository root and adjust. All variables
# have working defaults in docker-compose.yml, so `.env` is not required.
# Never commit real credentials; this deployment has no secrets today.

# Host port for the web UI. Open http://localhost:<FRONTEND_PORT> in a browser.
FRONTEND_PORT=8080

# ── FastAPI backend (backend/app/config.py) ────────────────────────────────
# Comma-separated allowed CORS origins. Empty = no cross-origin access
# (fine for the single-origin Nginx setup). Set e.g. "https://app.example.com".
CORS_ORIGINS=

# Maximum accepted dataset upload size in megabytes.
MAX_UPLOAD_SIZE_MB=2048

# Seed bundled sample datasets on startup ("1" or "0").
SEED_SAMPLE_DATASETS=1

# SQLite database location inside the container (persisted on a named volume).
DATABASE_URL=sqlite:////app/data/phronesisml.db

# ── Frontend build-time variables (baked into the static bundle by Vite) ──
# Relative values make the browser talk to the SAME origin as the page,
# which Nginx proxies to the backend. Absolute URLs are also accepted.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1
VITE_DEMO_MODE=false

# ── Local (non-Docker) development overrides ────────────────────────────────
# The dev frontend (Vite on :5173) expects these instead:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#   VITE_WS_BASE_URL=ws://localhost:8000/api/v1
#   VITE_DEMO_MODE=false
#   CORS_ORIGINS=http://localhost:5173