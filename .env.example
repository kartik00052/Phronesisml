# PhronesisML container deployment — optional overrides.
# Copy this file to `.env` in the repository root and adjust. All variables
# have working defaults in docker-compose.yml, so `.env` is not required.
# Never commit real credentials; this deployment has no secrets today.

# Host port for the web UI. Open http://localhost:<FRONTEND_PORT> in a browser.
FRONTEND_PORT=8080

# ── FastAPI backend (backend/app/config.py) ────────────────────────────────
# Comma-separated allowed CORS origins. Empty = no cross-origin access
# (fine for the single-origin Nginx setup). Set e.g. "https://app.example.com".
CORS_ORIGINS=

# Maximum accepted dataset upload size in megabytes.
MAX_UPLOAD_SIZE_MB=2048

# Seed bundled sample datasets on startup ("1" or "0").
SEED_SAMPLE_DATASETS=1

# SQLite database location inside the container (persisted on a named volume).
DATABASE_URL=sqlite:////app/data/phronesisml.db

# ── Supabase authentication (hosted Postgres + JWT) ─────────────────────────
# Leave AUTH_MODE=disabled for the SQLite/self-hosted flow (no token needed —
# the backend uses a fixed local-dev identity). Set AUTH_MODE=supabase to turn
# on JWT verification. NEVER commit real values; copy them from the Supabase
# Dashboard → Settings → API / Auth. Example shape only:
#
#   AUTH_MODE=disabled
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY=<anon-key-from-settings-api>
#   SUPABASE_JWT_SECRET=<jwt-secret-from-settings-api>
#   SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
#   SUPABASE_JWT_AUDIENCE=authenticated
AUTH_MODE=${AUTH_MODE:-disabled}
SUPABASE_URL=${SUPABASE_URL:-}
SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY:-}
SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET:-}
SUPABASE_JWKS_URL=${SUPABASE_JWKS_URL:-}
SUPABASE_JWT_ISSUER=${SUPABASE_JWT_ISSUER:-}
SUPABASE_JWT_AUDIENCE=${SUPABASE_JWT_AUDIENCE:-}

# ── Supabase (frontend build-time, baked in by Vite) ────────────────────────
# These two must be set when AUTH_MODE=supabase so the browser can open the
# Supabase JS client and fetch tokens. Placeholders only — never real keys.
VITE_SUPABASE_URL=${VITE_SUPABASE_URL:-}
VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY:-}

# ── Frontend build-time variables (baked into the static bundle by Vite) ──
# Relative values make the browser talk to the SAME origin as the page,
# which Nginx proxies to the backend. Absolute URLs are also accepted.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1
VITE_DEMO_MODE=false

# ── Local (non-Docker) development overrides ────────────────────────────────
# The dev frontend (Vite on :5173) expects these instead:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
#   VITE_WS_BASE_URL=ws://localhost:8000/api/v1
#   VITE_DEMO_MODE=false
#   CORS_ORIGINS=http://localhost:5173